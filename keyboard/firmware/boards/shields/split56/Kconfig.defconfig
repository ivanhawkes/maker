# Generated by tools/zmk_generate.py from pcb/pins.yaml and layout/generated/. Do not edit.
#
# The dongle is the split central and both halves are peripherals (docs/decisions.md).

if SHIELD_SPLIT56_DONGLE

config ZMK_KEYBOARD_NAME
    default "Split56"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# The peripherals plus ZMK's five host profiles (ZMK dongle guide).
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

endif

if SHIELD_SPLIT56_LEFT || SHIELD_SPLIT56_RIGHT || SHIELD_SPLIT56_DONGLE

config ZMK_SPLIT
    default y

endif

if SHIELD_SPLIT56_LEFT || SHIELD_SPLIT56_RIGHT

# The halves run on batteries: deep sleep after ZMK's idle-sleep timeout. A key press wakes them.
config ZMK_SLEEP
    default y

endif
